{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "curved-timeline variables",
  "type": "object",
  "required": ["title","milestones"],
  "properties": {
    "title":          { "type": "string" },
    "milestones":     { "type": "string", "description": "JSON array of {year,label,heading,body}" },
    "primaryColor":   { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "bgColor":        { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "basePlateImage": { "type": "string", "enum": ["v2-base-blue.png","v2-base-green.png","v2-base-red.png","v2-base-charcoal.png","v2-base-gold.png","v2-base-purple.png"] },
    "durPerItem":     { "type": "number", "minimum": 2, "maximum": 8 }
  }
}
