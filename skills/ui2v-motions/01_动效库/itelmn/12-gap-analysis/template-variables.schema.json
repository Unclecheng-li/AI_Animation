{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gap-analysis variables",
  "type": "object",
  "required": ["title","items"],
  "properties": {
    "title":            { "type": "string" },
    "subtitle":         { "type": "string" },
    "currentScore":     { "type": "number", "minimum": 0, "maximum": 100 },
    "targetScore":      { "type": "number", "minimum": 0, "maximum": 100 },
    "items":            { "type": "string", "description": "JSON array of {label,current,target}" },
    "primaryColor":     { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "performanceColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "potentialColor":   { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "bgColor":          { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "basePlateImage":   { "type": "string", "enum": ["v2-base-blue.png","v2-base-green.png","v2-base-red.png","v2-base-charcoal.png","v2-base-gold.png","v2-base-purple.png"] },
    "duration":         { "type": "number", "minimum": 5, "maximum": 30 }
  }
}
