{
  "name": "@ui2v/workspace",
  "version": "2.0.2",
  "description": "UI2V video motion asset library for discovering, installing, publishing, syncing, and sharing HyperFrames packages.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter \"@ui2v/cli\" build",
    "dev": "bun run --filter \"@ui2v/cli\" dev",
    "test": "bun run --filter \"@ui2v/cli\" test",
    "ui2v": "node packages/ui2v/bin/ui2v.js",
    "cli": "node packages/ui2v/bin/ui2v.js"
  },
  "keywords": [
    "ui2v",
    "hyperframes",
    "motion",
    "registry",
    "cli"
  ],
  "author": "ui2v",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^25.5.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  }
}
