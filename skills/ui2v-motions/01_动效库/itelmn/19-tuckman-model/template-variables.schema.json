{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tuckman-model variables",
  "type": "object",
  "required": ["title","stages"],
  "properties": {
    "title":          { "type": "string" },
    "stages":         { "type": "string", "description": "JSON array of {name,desc,short}" },
    "xAxisLabel":     { "type": "string" },
    "yAxisLabel":     { "type": "string" },
    "curveColor":     { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "dotColor":       { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "bgColor":        { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "basePlateImage": { "type": "string", "enum": ["v2-base-blue.png","v2-base-green.png","v2-base-red.png","v2-base-charcoal.png","v2-base-gold.png","v2-base-purple.png"] },
    "durationPerStage": { "type": "number", "minimum": 2, "maximum": 10 }
  }
}
