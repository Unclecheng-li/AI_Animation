{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "terms-definitions variables",
  "type": "object",
  "required": ["title","terms"],
  "properties": {
    "title":          { "type": "string" },
    "terms":          { "type": "string", "description": "JSON array of {icon,label,definition}" },
    "accentColor":    { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "bgColor":        { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "basePlateImage": { "type": "string", "enum": ["v2-base-blue.png","v2-base-green.png","v2-base-red.png","v2-base-charcoal.png","v2-base-gold.png","v2-base-purple.png"] },
    "durationPerTerm":{ "type": "number", "minimum": 3, "maximum": 10 }
  }
}
