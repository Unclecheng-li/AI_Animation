{
  "$schema": "schemas/template.schema.json",
  "id": "stacked-area-story",
  "name": "Stacked-area Story",
  "description": "Multiple time series accumulate into a flowing stacked-area composition with absolute and percentage views, live mix readouts, and a polished finale.",
  "category": "data-viz",
  "bestFor": [
    "category composition over time",
    "revenue mix stories",
    "traffic-source share",
    "portfolio or cohort composition"
  ],
  "engine": "hyperframes",
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "fps": 30,
  "duration": 18,
  "dataShape": "long",
  "requiredColumns": [
    "date",
    "series",
    "value"
  ],
  "displayOrder": 4,
  "sampleData": "sample-stacked-area.csv",
  "preview": "/previews/stacked-area-finale.png",
  "previewVideo": "/previews/stacked-area.mp4",
  "variants": [
    {
      "id": "absolute",
      "label": "Absolute total",
      "flag": "--stack-mode absolute"
    },
    {
      "id": "percent",
      "label": "100% composition",
      "flag": "--stack-mode percent"
    }
  ],
  "license": "MIT"
}
