{
  "$schema": "../../schemas/template.schema.json",
  "id": "kpi-dashboard",
  "name": "KPI Dashboard",
  "description": "A cinematic performance board stages multiple KPIs, target progress, and direction of change without feeling like a static dashboard.",
  "category": "data-viz",
  "bestFor": ["business reviews", "launch metrics", "portfolio performance", "executive reporting"],
  "engine": "hyperframes",
  "resolution": { "width": 1920, "height": 1080 },
  "fps": 30,
  "duration": 18,
  "dataShape": "metric rows",
  "requiredColumns": ["metric", "value", "target", "change"],
  "displayOrder": 7,
  "sampleData": "sample-kpi.csv",
  "preview": "/previews/kpi-dashboard-finale.png",
  "previewVideo": "/previews/kpi-dashboard.mp4",
  "variants": [
    { "id": "cards", "label": "Metric cards", "flag": "--kpi-mode cards" },
    { "id": "radial", "label": "Radial progress", "flag": "--kpi-mode radial" }
  ],
  "license": "MIT"
}
