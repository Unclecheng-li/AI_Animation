{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotbeat.dev/schemas/template.schema.json",
  "title": "HyperFrames data visualization template",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "category", "bestFor", "engine", "resolution", "fps", "duration", "dataShape", "requiredColumns", "displayOrder", "sampleData", "preview", "previewVideo", "license"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 20 },
    "category": { "const": "data-viz" },
    "bestFor": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "engine": { "const": "hyperframes" },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 320 }
      }
    },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "dataShape": { "type": "string", "minLength": 2 },
    "requiredColumns": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
    "displayOrder": { "type": "integer", "minimum": 1 },
    "sampleData": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*\\.(csv|json)$" },
    "preview": { "type": "string", "pattern": "^/previews/[a-zA-Z0-9._/-]+\\.(png|jpe?g|webp)$" },
    "previewVideo": { "type": "string", "pattern": "^/previews/[a-zA-Z0-9._/-]+\\.(mp4|webm)$" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "flag"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 2 },
          "flag": { "type": "string", "minLength": 3 }
        }
      }
    },
    "license": { "type": "string", "minLength": 2 }
  }
}
