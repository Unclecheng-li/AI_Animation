{
  "$schema": "../../schemas/template.schema.json",
  "id": "bar-race",
  "name": "Bar Race",
  "description": "Ranked horizontal bars trade places over time while the scale and current-period readout update continuously.",
  "category": "data-viz",
  "bestFor": ["leaderboards", "category growth", "market rankings", "competitive change"],
  "engine": "hyperframes",
  "resolution": { "width": 1920, "height": 1080 },
  "fps": 30,
  "duration": 18,
  "dataShape": "long",
  "requiredColumns": ["date", "series", "value"],
  "displayOrder": 3,
  "sampleData": "sample-multi.csv",
  "preview": "/previews/bar-race-finale.png",
  "previewVideo": "/previews/bar-race.mp4",
  "variants": [
    { "id": "absolute", "label": "Absolute values", "flag": "--bar-mode absolute" },
    { "id": "leader-index", "label": "Leader indexed", "flag": "--bar-mode leader-index" }
  ],
  "license": "MIT"
}
