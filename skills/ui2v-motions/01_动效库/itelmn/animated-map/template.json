{
  "$schema": "../../schemas/template.schema.json",
  "id": "animated-map",
  "name": "Animated Map",
  "description": "Locations pulse across a stylized world map while optional connection flows and live intensity readouts build the geographic story.",
  "category": "data-viz",
  "bestFor": ["global activity", "network expansion", "regional demand", "location intensity"],
  "engine": "hyperframes",
  "resolution": { "width": 1920, "height": 1080 },
  "fps": 30,
  "duration": 18,
  "dataShape": "location rows",
  "requiredColumns": ["location", "latitude", "longitude", "value"],
  "displayOrder": 6,
  "sampleData": "sample-map.csv",
  "preview": "/previews/animated-map-finale.png",
  "previewVideo": "/previews/animated-map.mp4",
  "variants": [
    { "id": "pulse", "label": "Location pulse", "flag": "--map-mode pulse" },
    { "id": "flow", "label": "Connection flow", "flag": "--map-mode flow" }
  ],
  "license": "MIT"
}
