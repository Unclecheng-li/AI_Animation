{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "scan-band",
  "type": "hyperframes:block",
  "title": "Scan Band",
  "description": "A diagonal distortion band sweeps once across a clean wordmark, revealing clipped red and cyan offsets only inside the moving band.",
  "tags": [
    "motion-primitive",
    "typography",
    "scan",
    "chromatic",
    "distortion",
    "wordmark"
  ],
  "jobs": [
    "reveal"
  ],
  "family": "effects",
  "profile": "sweep",
  "evidence": "Wave F U6 scan-band build contract",
  "files": [
    {
      "path": "index.html",
      "target": "compositions/scan-band.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "scan-band.html",
      "target": "scan-band.html",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "wordmark",
      "type": "string",
      "role": "content",
      "label": "Wordmark",
      "description": "Text displayed by the scan effect.",
      "default": "HYPERFRAMES"
    },
    {
      "id": "band_angle",
      "type": "number",
      "role": "layout",
      "label": "Band angle",
      "description": "Diagonal angle of the distortion band in degrees.",
      "default": 12,
      "min": -30,
      "max": 30,
      "step": 1,
      "unit": "deg"
    }
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 5.0
}
