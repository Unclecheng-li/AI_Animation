{
  "$schema": "../../schemas/template.schema.json",
  "id": "milestone-timeline",
  "name": "Milestone Timeline",
  "description": "Events reveal across a continuous timeline with alternating chapter cards, a moving playhead, and a focused live milestone readout.",
  "category": "data-viz",
  "bestFor": ["launch histories", "company stories", "project roadmaps", "product evolution"],
  "engine": "hyperframes",
  "resolution": { "width": 1920, "height": 1080 },
  "fps": 30,
  "duration": 18,
  "dataShape": "event rows",
  "requiredColumns": ["date", "title"],
  "displayOrder": 8,
  "sampleData": "sample-milestones.csv",
  "preview": "/previews/milestone-timeline-finale.png",
  "previewVideo": "/previews/milestone-timeline.mp4",
  "variants": [
    { "id": "continuous", "label": "Continuous line", "flag": "--timeline-mode continuous" },
    { "id": "chapters", "label": "Chapter cards", "flag": "--timeline-mode chapters" }
  ],
  "license": "MIT"
}
