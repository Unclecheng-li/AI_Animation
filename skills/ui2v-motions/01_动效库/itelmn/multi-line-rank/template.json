{
  "$schema": "../../schemas/template.schema.json",
  "id": "multi-line-rank",
  "name": "Multi-line Rank",
  "description": "Multiple time series grow together while a live legend glides through rank changes, followed by a final table.",
  "category": "data-viz",
  "bestFor": ["category comparisons", "market-share stories", "cohort races", "multi-series trends"],
  "engine": "hyperframes",
  "resolution": { "width": 1920, "height": 1080 },
  "fps": 30,
  "duration": 18,
  "dataShape": "long",
  "requiredColumns": ["date", "series", "value"],
  "displayOrder": 2,
  "sampleData": "sample-multi.csv",
  "preview": "/previews/multi-line-finale.png",
  "previewVideo": "/previews/multi-line.mp4",
  "variants": [
    { "id": "full-field", "label": "Full field", "flag": "--max-ranked 17" },
    { "id": "top-five", "label": "Top five", "flag": "--max-ranked 5" }
  ],
  "license": "MIT"
}
