  "templates": [
    {
      "$schema": "schemas/template.schema.json",
      "id": "single-line-story",
      "name": "Single-line Story",
      "description": "A single time series grows across the frame with a live endpoint readout and a decisive final lockup.",
      "category": "data-viz",
      "bestFor": [
        "trend stories",
        "KPI history",
        "price or index changes",
        "single-metric narratives"
      ],
      "engine": "hyperframes",
      "resolution": {
        "width": 1920,
        "height": 1080
      },
      "fps": 30,
      "duration": 18,
      "dataShape": "wide",
      "requiredColumns": [
        "date",
        "value"
      ],
      "displayOrder": 1,
      "sampleData": "sample-single.csv",
      "preview": "/previews/single-line-finale.png",
      "previewVideo": "/previews/single-line.mp4",
      "variants": [
        {
          "id": "linear",
          "label": "Linear trace",
          "flag": "--path-style linear"
        },
        {
          "id": "smooth",
          "label": "Smooth trace",
          "flag": "--path-style smooth"
        }
      ],
      "license": "MIT"
    },
    {
