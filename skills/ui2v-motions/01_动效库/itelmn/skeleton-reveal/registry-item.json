{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "skeleton-reveal",
  "type": "hyperframes:block",
  "title": "Skeleton Reveal",
  "description": "A skeleton loader transition that pulses, then cross-fades into content",
  "tags": [
    "video-primitive",
    "transition-primitive",
    "transitions-dev-port",
    "skeleton",
    "reveal"
  ],
  "files": [
    {
      "path": "index.html",
      "target": "compositions/skeleton-reveal.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "skeleton-reveal.html",
      "target": "skeleton-reveal.html",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "name",
      "type": "string",
      "role": "content",
      "label": "Name",
      "description": "Primary line revealed once the skeleton fades out.",
      "default": "Jane Cooper"
    },
    {
      "id": "detail",
      "type": "string",
      "role": "content",
      "label": "Detail",
      "description": "Secondary line under the name, such as an email or a role.",
      "default": "jane@example.com"
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Card palette. Light is the paper card, dark is a near-black card with the matching skeleton bars and text.",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/skeleton-reveal.png"
  },
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 5.0
}
