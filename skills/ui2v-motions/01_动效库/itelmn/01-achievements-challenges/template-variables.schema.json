{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "achievements-challenges variables",
  "type": "object",
  "required": ["title","items"],
  "properties": {
    "title":          { "type": "string" },
    "leftLabel":      { "type": "string" },
    "rightLabel":     { "type": "string" },
    "items":          { "type": "string", "description": "JSON array of {left,right}" },
    "leftColor":      { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "rightColor":     { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "bgColor":        { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "basePlateImage": { "type": "string", "enum": ["v2-base-blue.png","v2-base-green.png","v2-base-red.png","v2-base-charcoal.png","v2-base-gold.png","v2-base-purple.png"] },
    "durationPerItem":{ "type": "number", "minimum": 2, "maximum": 8 }
  }
}
