{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "medical-tabs variables",
  "type": "object",
  "required": ["title","tabs"],
  "properties": {
    "title":           { "type": "string" },
    "tabs":            { "type": "string", "description": "JSON array of {label,icon,heading,body}" },
    "primaryColor":    { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "bgColor":         { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "basePlateImage":  { "type": "string", "enum": ["v2-base-blue.png","v2-base-green.png","v2-base-red.png","v2-base-charcoal.png","v2-base-gold.png","v2-base-purple.png"] },
    "durationPerTab":  { "type": "number", "minimum": 3, "maximum": 10 },
    "activeTab":       { "type": "number", "minimum": 0, "maximum": 6 }
  }
}
