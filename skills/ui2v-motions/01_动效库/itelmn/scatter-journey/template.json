{
  "$schema": "../../schemas/template.schema.json",
  "id": "scatter-journey",
  "name": "Scatter Journey",
  "description": "Entities move through two-dimensional space over time with connected trails, live coordinates, and optional bubble sizing.",
  "category": "data-viz",
  "bestFor": ["positioning maps", "risk and return", "product adoption", "multi-factor movement"],
  "engine": "hyperframes",
  "resolution": { "width": 1920, "height": 1080 },
  "fps": 30,
  "duration": 18,
  "dataShape": "long",
  "requiredColumns": ["date", "series", "x", "y"],
  "displayOrder": 5,
  "sampleData": "sample-scatter.csv",
  "preview": "/previews/scatter-journey-finale.png",
  "previewVideo": "/previews/scatter-journey.mp4",
  "variants": [
    { "id": "trail", "label": "Connected trail", "flag": "--scatter-mode trail" },
    { "id": "bubble", "label": "Bubble trail", "flag": "--scatter-mode bubble" }
  ],
  "license": "MIT"
}
