{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "drift-hold",
  "type": "hyperframes:block",
  "title": "Drift Hold",
  "description": "A centered content card stays subtly alive through loop-exact rotation, scale breathing, and a slow light sweep.",
  "tags": [
    "motion-primitive",
    "camera",
    "ambient",
    "drift",
    "hold",
    "loopable"
  ],
  "jobs": [
    "orient"
  ],
  "family": "camera",
  "profile": "ambient",
  "evidence": "Wave G U18 drift-hold specification",
  "files": [
    {
      "path": "index.html",
      "target": "compositions/drift-hold.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "drift-hold.html",
      "target": "drift-hold.html",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "role": "content",
      "label": "Text",
      "description": "Text displayed in the default centered card.",
      "default": "Always alive"
    },
    {
      "id": "intensity",
      "type": "enum",
      "role": "motion",
      "label": "Intensity",
      "description": "Amplitude of the ambient rotation, breathing, and light sweep.",
      "default": "standard",
      "options": [
        {
          "value": "whisper",
          "label": "Whisper"
        },
        {
          "value": "standard",
          "label": "Standard"
        }
      ]
    }
  ],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 5.0
}
